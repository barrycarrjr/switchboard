{
  "name": "switchboard",
  "productName": "Switchboard",
  "version": "0.6.13",
  "description": "A Windows tray manager for AI CLIs and the accounts they use.",
  "license": "MIT",
  "author": "Switchboard contributors",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "switchboard": "bin/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "io.switchboard.app",
    "productName": "Switchboard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "core/**/*",
      "bin/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Switchboard-Setup-${version}.${ext}",
      "shortcutName": "Switchboard"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
